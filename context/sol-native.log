        str(apple / 'Checks/Smoke.swift'), '-o', str(executable)
    ], check=True)
    result = subprocess.run([str(executable)], env=env, text=True, capture_output=True)
    (apple / 'smoke.log').write_text(result.stdout + result.stderr)
