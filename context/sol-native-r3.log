import SwiftUI

struct SceneDetailView: View {
    var id: String
    @Environment(APIClient.self) private var api
    @Environment(AppNavigation.self) private var navigation
    @Environment(\.dismiss) private var dismiss
    @Environment(\.openURL) private var openURL
    @State private var store = LoadStore<Scene>()
    @State private var selectedFrame: String?
    var body: some View {
        NavigationStack {
            ScrollView {
                VStack(alignment: .leading, spacing: 16) {
                    if let error = store.error { ErrorNotice(message: error) { Task { await load() } } }
                    if let scene = store.value {
                        RemoteImage(path: selectedFrame ?? scene.image).frame(height: 320).clipShape(.rect(cornerRadius: 10))
                        if let frames = scene.frame_urls, frames.count > 1 {
                            ScrollView(.horizontal) {
                                HStack {
                                    ForEach(frames, id: \.self) { frame in
                                        Button { selectedFrame = frame } label: {
                                            RemoteImage(path: frame).frame(width: 120, height: 80).clipShape(.rect(cornerRadius: 6))
                                                .overlay(RoundedRectangle(cornerRadius: 6).stroke(selectedFrame == frame ? Color.accentColor : .clear, lineWidth: 2))
                                        }.buttonStyle(.plain).accessibilityLabel("Show frame \((frames.firstIndex(of: frame) ?? 0) + 1)")
                                    }
                                }
                            }
                        }
                        Text(scene.displayTitle).font(.title2).fontWeight(.semibold)
                        Text("at \(scene.timestamp ?? "0:00")").font(.subheadline.monospacedDigit()).foregroundStyle(.secondary)
                        if let description = scene.description, !description.isEmpty { Text(description) }
                        HStack {
                            Button("Open at \(scene.timestamp ?? "0:00") ↗") { if let url = URL(string: scene.link) { openURL(url) } }.buttonStyle(.borderedProminent)
                            if let url = URL(string: scene.link) { ShareLink(item: url) }
                        }
                        if let source = scene.source {
                            NavigationLink {
                                SourceDetailView(id: source.id)
                            } label: {
                                VStack(alignment: .leading) {
                                    Text("From \(source.displayTitle)")
                                    Text(source.author.hasPrefix("@") ? source.author : "@\(source.author)").font(.subheadline).foregroundStyle(.secondary)
                                }
                            }
                        }
                        if let tags = scene.tags {
                            ForEach(["technique", "style", "format", "motion", "medium", "palette", "concepts"], id: \.self) { facet in
                                if let values = tags[facet], !values.isEmpty {
                                    Text(facet.capitalized).font(.headline)
                                    LazyVGrid(columns: [GridItem(.adaptive(minimum: 120))], alignment: .leading) {
                                        ForEach(values, id: \.self) { tag in
                                            Button(tag) {
                                                navigation.focus("idea:\(facet):\(tag)")
                                                dismiss()
                                            }.buttonStyle(.bordered).tint(facetColor(facet))
                                        }
                                    }
                                }
                            }
                        }
                    } else if store.loading { ProgressView().frame(maxWidth: .infinity).padding(80) }
                }.padding().frame(maxWidth: 850).frame(maxWidth: .infinity)
            }.navigationTitle("Scene")
            .toolbar { ToolbarItem(placement: .confirmationAction) { Button("Done") { dismiss() } } }
            .task(id: id) { await load() }
            .onChange(of: navigation.mapFocus) { dismiss() }
        }
        #if os(macOS)
        .frame(minWidth: 650, idealWidth: 800, minHeight: 650)
        #endif
    }
    private func load() async { await store.load { try await api.request("scenes/\(id)") } }
}

struct SourceDetailView: View {
    var id: String
    @Environment(APIClient.self) private var api
    @State private var store = LoadStore<Source>()
    @State private var detail: ItemID?
    @State private var sending = false
    @State private var actionError: String?
    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 16) {
                if let error = store.error { ErrorNotice(message: error) { Task { await load() } } }
                if let error = actionError { Text(error).foregroundStyle(.red) }
                if let source = store.value {
                    Text(source.displayTitle).font(.title2)
                    Text(source.author.hasPrefix("@") ? source.author : "@\(source.author)").foregroundStyle(.secondary)
                    HStack {
                        if let url = URL(string: source.url) { Link("Open source ↗", destination: url) }
                        Spacer()
                        Button { Task { await vote(source.verdict == "dislike" ? "clear" : "dislike") } } label: {
                            Label("Dislike", systemImage: source.verdict == "dislike" ? "xmark.circle.fill" : "xmark.circle")
                        }.tint(source.verdict == "dislike" ? .red : .secondary)
                        Button { Task { await vote(source.verdict == "like" ? "clear" : "like") } } label: {
                            Label("Like", systemImage: source.verdict == "like" ? "heart.fill" : "heart")
                        }.tint(source.verdict == "like" ? .pink : .secondary)
                    }.buttonStyle(.bordered).disabled(sending)
                    HStack {
                        if let platform = source.platform { Text(platform.capitalized) }
                        if let duration = source.duration { Text("\(Int(duration) / 60):\(String(format: "%02d", Int(duration) % 60))") }
                        if let origin = source.origin { Text(origin.capitalized) }
                    }.font(.subheadline).foregroundStyle(.secondary)
                    if let pitch = source.pitch, !pitch.isEmpty { Text(pitch) }
                    if let status = source.status { Text(status.capitalized).font(.caption).foregroundStyle(.secondary) }
                    let scenes = source.scenes ?? []
                    if scenes.isEmpty { ContentUnavailableView("No scenes yet", systemImage: "photo.stack") }
                    LazyVGrid(columns: [GridItem(.adaptive(minimum: 155, maximum: 280), alignment: .top)], spacing: 20) {
                        ForEach(scenes) { scene in
                            Button { detail = ItemID(id: scene.id) } label: { SceneCard(scene: scene) }.buttonStyle(.plain)
                        }
                    }
                } else if store.loading { ProgressView().frame(maxWidth: .infinity).padding(80) }
            }.padding()
        }.navigationTitle("Source")
        .task(id: id) { await load() }
        .sheet(item: $detail) { SceneDetailView(id: $0.id) }
    }
    private func load() async { await store.load { try await api.request("sources/\(id)") } }
    private func vote(_ verdict: String) async {
        sending = true; actionError = nil
        do { try await api.swipe(id, verdict); await load() } catch { actionError = error.localizedDescription }
        sending = false
    }
}
import SwiftUI

struct HistoryView: View {
    @Environment(APIClient.self) private var api
    @State private var store = LoadStore<Items<HistoryItem>>()
    @State private var filter = "All"
    @State private var sending = false
    @State private var actionError: String?
    private var items: [HistoryItem] {
        (store.value?.items ?? []).filter { filter == "All" || $0.verdict == (filter == "Liked" ? "like" : "dislike") }
    }
    var body: some View {
        VStack(spacing: 0) {
            Picker("Verdict", selection: $filter) {
                ForEach(["All", "Liked", "Disliked"], id: \.self) { Text($0) }
            }.pickerStyle(.segmented).padding()
            if let error = actionError { Text(error).foregroundStyle(.red) }
            if let error = store.error { ErrorNotice(message: error) { Task { await load() } } }
            if store.loading { ProgressView() }
            List(items) { item in
                NavigationLink { SourceDetailView(id: item.id) } label: {
                    HStack(spacing: 12) {
                        RemoteImage(path: item.cover).frame(width: 70, height: 55).clipShape(.rect(cornerRadius: 6))
                        VStack(alignment: .leading, spacing: 4) {
                            Text(item.title.isEmpty ? "Untitled source" : item.title).lineLimit(2)
                            Text(item.author.hasPrefix("@") ? item.author : "@\(item.author)").font(.subheadline).foregroundStyle(.secondary)
                            if let date = item.date { Text(date, style: .relative).font(.caption).foregroundStyle(.secondary) }
                        }
                        Spacer()
                        Image(systemName: item.verdict == "like" ? "heart.fill" : "xmark").foregroundStyle(item.verdict == "like" ? Color.pink : Color.secondary)
                    }
                }
                .swipeActions {
                    Button("Clear", role: .destructive) { Task { await update(item.id, "clear") } }
                    Button(item.verdict == "like" ? "Dislike" : "Like") { Task { await update(item.id, item.verdict == "like" ? "dislike" : "like") } }.tint(.accentColor)
                }
                .contextMenu {
                    Button(item.verdict == "like" ? "Dislike" : "Like") { Task { await update(item.id, item.verdict == "like" ? "dislike" : "like") } }
                    Button("Clear verdict", role: .destructive) { Task { await update(item.id, "clear") } }
                }
            }.disabled(sending)
            .overlay { if items.isEmpty && !store.loading && store.error == nil { ContentUnavailableView("No \(filter == "All" ? "swipes" : filter.lowercased() + " picks") yet", systemImage: "clock", description: Text("Your swipe history appears here.")) } }
            .refreshable { await load() }
        }.navigationTitle("History")
        .toolbar { Button("Refresh", systemImage: "arrow.clockwise") { Task { await load() } } }
        .task(id: api.revision) { await load() }
    }
    private func load() async { await store.load { try await api.request("history") } }
    private func update(_ id: String, _ verdict: String) async {
        guard !sending else { return }
        sending = true; actionError = nil
        do { try await api.swipe(id, verdict); await load() } catch { actionError = error.localizedDescription }
        sending = false
    }
}
import SwiftUI

struct TodayView: View {
    @Environment(APIClient.self) private var api
    @Environment(AppNavigation.self) private var navigation
    @Environment(\.openURL) private var openURL
    @Environment(\.accessibilityReduceMotion) private var reduceMotion
    @State private var store = LoadStore<TodayResponse>()
    @State private var sceneIndex = 0
    @State private var offset: CGFloat = 0
    @State private var sending = false
    @State private var undoIDs: [String] = []
    @State private var actionError: String?
    private var current: Source? { store.value?.items.first { $0.verdict == nil } }
    private var scenes: [Scene] { current?.scenes ?? [] }
    private var scene: Scene? { scenes.isEmpty ? nil : scenes[min(sceneIndex, scenes.count - 1)] }
    var body: some View {
        ScrollView {
            VStack(spacing: 16) {
                if let error = store.error { ErrorNotice(message: error) { Task { await reload() } } }
                if let error = actionError { Text(error).foregroundStyle(.red) }
                if let today = store.value {
                    HStack { Spacer(); Text("\(today.items.filter { $0.verdict == nil }.count) of \(today.total) left").foregroundStyle(.secondary) }
                    if today.total == 0 {
                        ContentUnavailableView("Grokbot hasn't sent today's picks yet", systemImage: "tray", description: Text("Pull to refresh for new picks."))
                    } else if let item = current {
                        card(item)
                        HStack(spacing: 40) {
                            Button { Task { await vote("dislike") } } label: { Image(systemName: "xmark").frame(width: 40, height: 40) }
                                .keyboardShortcut(.leftArrow, modifiers: []).accessibilityLabel("Dislike")
                            Button { Task { await undo() } } label: { Image(systemName: "arrow.uturn.backward").frame(width: 40, height: 40) }
                                .keyboardShortcut("z", modifiers: .command).disabled(undoIDs.isEmpty).accessibilityLabel("Undo swipe")
                            Button { Task { await vote("like") } } label: { Image(systemName: "heart").frame(width: 40, height: 40) }
                                .keyboardShortcut(.rightArrow, modifiers: []).accessibilityLabel("Like")
                        }.buttonStyle(.bordered).buttonBorderShape(.circle).disabled(sending)
                    } else {
                        ContentUnavailableView {
                            Label("Done for today · \(today.items.filter { $0.verdict == "like" }.count) liked", systemImage: "checkmark.circle")
                        } actions: { Button("Go to Map") { navigation.selection = .map } }
                        if !undoIDs.isEmpty { Button("Undo last swipe") { Task { await undo() } }.keyboardShortcut("z", modifiers: .command).disabled(sending) }
                    }
                } else if store.loading { ProgressView().padding(80) }
            }.padding().frame(maxWidth: 680).frame(maxWidth: .infinity)
        }
        .navigationTitle("Today")
        .refreshable { await reload() }
        .toolbar { Button("Refresh", systemImage: "arrow.clockwise") { Task { await reload() } }.disabled(sending) }
        .task(id: api.revision) { if !sending { await reload() } }
        .onChange(of: current?.id) { sceneIndex = 0 }
    }
    private func card(_ item: Source) -> some View {
        VStack(alignment: .leading, spacing: 12) {
            Button {
                if !scenes.isEmpty { sceneIndex = (sceneIndex + 1) % scenes.count }
            } label: {
                RemoteImage(path: scene?.image).frame(height: 320).clipShape(.rect(cornerRadius: 12))
            }.buttonStyle(.plain).accessibilityLabel("Next scene")
            HStack(spacing: 6) {
                Spacer()
                ForEach(Array(scenes.enumerated()), id: \.element.id) { index, _ in
                    Button { sceneIndex = index } label: {
                        Image(systemName: index == sceneIndex ? "circle.fill" : "circle").font(.system(size: 7))
                    }.buttonStyle(.plain).accessibilityLabel("Scene \(index + 1) of \(scenes.count)")
                }
                Spacer()
            }
            Text(item.displayTitle).font(.title2).fontWeight(.semibold)
            HStack {
                Text(item.author.hasPrefix("@") ? item.author : "@\(item.author)")
                if let duration = item.duration { Text("· \(Int(duration) / 60):\(String(format: "%02d", Int(duration) % 60))") }
                Text("· \(item.origin == "grok" ? "Grok pick" : "Manual pick")")
            }.font(.subheadline).foregroundStyle(.secondary)
            if let pitch = item.pitch, !pitch.isEmpty { Text(pitch) }
            Button("Open at \(scene?.timestamp ?? "0:00") ↗") {
                if let url = URL(string: scene?.link ?? item.url) { openURL(url) }
            }.buttonStyle(.bordered)
        }
        .offset(x: offset).rotationEffect(.degrees(reduceMotion ? 0 : Double(offset / 30)))
        .gesture(DragGesture().onChanged { if !sending { offset = $0.translation.width } }.onEnded {
            guard !sending else { return }
            if abs($0.translation.width) > 120 { let verdict = $0.translation.width > 0 ? "like" : "dislike"; Task { await vote(verdict) } }
            else { withAnimation(.spring) { offset = 0 } }
        })
    }
    private func reload() async { await store.load { try await api.request("today") } }
    private func vote(_ verdict: String) async {
        guard let item = current, !sending else { return }
        sending = true; actionError = nil
        withAnimation(reduceMotion ? nil : .easeIn(duration: 0.18)) { offset = verdict == "like" ? 1000 : -1000 }
        do {
            try await api.swipe(item.id, verdict)
            try? await Task.sleep(for: .milliseconds(180))
            if let i = store.value?.items.firstIndex(where: { $0.id == item.id }) { store.value?.items[i].verdict = verdict }
            undoIDs.append(item.id)
        } catch { actionError = error.localizedDescription }
        offset = 0; sending = false
    }
    private func undo() async {
        guard let id = undoIDs.last, !sending else { return }
        sending = true; actionError = nil
        do {
            try await api.swipe(id, "clear")
            undoIDs.removeLast()
            await reload()
        } catch { actionError = error.localizedDescription }
        sending = false
    }
}
