import SwiftUI
import ImageIO
#if os(iOS)
import UIKit
typealias PlatformImage = UIImage
#else
import AppKit
typealias PlatformImage = NSImage
#endif

@MainActor final class ImageCache {
    static let shared = ImageCache()
    private let cache = NSCache<NSString, PlatformImage>()
    private var pending: [String: Task<PlatformImage?, Never>] = [:]
    init() { cache.totalCostLimit = 80 * 1024 * 1024; cache.countLimit = 500 }
    func cached(_ key: String) -> Image? { cache.object(forKey: key as NSString).map(Self.image) }
    static func image(_ native: PlatformImage) -> Image {
        #if os(iOS)
        Image(uiImage: native)
        #else
        Image(nsImage: native)
        #endif
    }
    func load(_ request: URLRequest, api: APIClient, maxPixel: Int = 1600) async -> Image? {
        guard let url = request.url else { return nil }
        let key = "\(url.absoluteString)|\(maxPixel)"
        if let hit = cached(key) { return hit }
        if let task = pending[key] { return await task.value.map(Self.image) }
        let task = Task<PlatformImage?, Never> {
            do {
                let (data, response) = try await URLSession.shared.data(for: request)
                if (response as? HTTPURLResponse)?.statusCode == 401 { api.unauthorized = true }
                guard let response = response as? HTTPURLResponse, (200..<300).contains(response.statusCode) else { return nil }
                let cgImage = await Task.detached(priority: .utility) {
                    guard let source = CGImageSourceCreateWithData(data as CFData, nil) else { return nil as CGImage? }
                    return CGImageSourceCreateThumbnailAtIndex(source, 0, [
                        kCGImageSourceCreateThumbnailFromImageAlways: true,
                        kCGImageSourceCreateThumbnailWithTransform: true,
                        kCGImageSourceThumbnailMaxPixelSize: maxPixel
                    ] as CFDictionary)
                }.value
                guard let cgImage else { return nil }
                #if os(iOS)
                let native = UIImage(cgImage: cgImage)
                #else
                let native = NSImage(cgImage: cgImage, size: NSSize(width: cgImage.width, height: cgImage.height))
                #endif
                cache.setObject(native, forKey: key as NSString, cost: cgImage.bytesPerRow * cgImage.height)
                return native
            } catch { return nil }
        }
        pending[key] = task
        let value = await task.value
        pending[key] = nil
        return value.map(Self.image)
    }
}

struct RemoteImage: View {
    @Environment(APIClient.self) private var api
    var path: String?
    var fit = true
    @State private var image: Image?
    @State private var loading = false
    var body: some View {
        GeometryReader { proxy in
            ZStack {
                Rectangle().fill(.quaternary)
                if let image {
                    image.resizable().aspectRatio(contentMode: fit ? .fit : .fill)
                        .frame(width: proxy.size.width, height: proxy.size.height).clipped()
                } else if loading { ProgressView() }
                else { Image(systemName: "photo").foregroundStyle(.secondary) }
            }
        }
        .task(id: "\(api.server)|\(api.revision)|\(path ?? "")") {
            image = nil
            guard let path, !path.isEmpty, let request = api.imageRequest(path) else { return }
            loading = true
            image = await ImageCache.shared.load(request, api: api)
            loading = false
        }
        .accessibilityLabel("Scene screenshot")
    }
}

struct ErrorNotice: View {
    var message: String
    var retry: () -> Void
    var body: some View {
        VStack(spacing: 12) {
            Label(message, systemImage: "exclamationmark.triangle").foregroundStyle(.secondary)
            Button("Try again", action: retry)
        }.padding().frame(maxWidth: .infinity)
    }
}
struct SceneCard: View {
    var scene: Scene
    var body: some View {
        VStack(alignment: .leading, spacing: 6) {
            RemoteImage(path: scene.image).frame(height: 140).clipShape(.rect(cornerRadius: 8))
            if let timestamp = scene.timestamp { Text(timestamp).font(.caption.monospacedDigit()).foregroundStyle(.secondary) }
            Text(scene.displayTitle).font(.subheadline).lineLimit(2)
        }.frame(maxWidth: .infinity, alignment: .leading).contentShape(Rectangle())
    }
}
func facetColor(_ facet: String?) -> Color {
    switch facet {
    case "technique": .blue
    case "style": .purple
    case "format": .orange
    case "motion": .green
    case "concepts": .teal
    default: .gray
    }
}
import SwiftUI

struct SceneDetailView: View {
    var id: String
    @Environment(APIClient.self) private var api
    @Environment(AppNavigation.self) private var navigation
    @Environment(\.dismiss) private var dismiss
    @Environment(\.openURL) private var openURL
    @State private var store = LoadStore<Scene>()
    @State private var selectedFrame: String?
    var body: some View {
        NavigationStack {
            ScrollView {
                VStack(alignment: .leading, spacing: 16) {
                    if let error = store.error { ErrorNotice(message: error) { Task { await load() } } }
                    if let scene = store.value {
                        RemoteImage(path: selectedFrame ?? scene.image).frame(height: 320).clipShape(.rect(cornerRadius: 10))
                        if let frames = scene.frame_urls, frames.count > 1 {
                            ScrollView(.horizontal) {
                                HStack {
                                    ForEach(frames, id: \.self) { frame in
                                        Button { selectedFrame = frame } label: {
                                            RemoteImage(path: frame).frame(width: 120, height: 80).clipShape(.rect(cornerRadius: 6))
                                                .overlay(RoundedRectangle(cornerRadius: 6).stroke(selectedFrame == frame ? Color.accentColor : .clear, lineWidth: 2))
                                        }.buttonStyle(.plain).accessibilityLabel("Show frame \((frames.firstIndex(of: frame) ?? 0) + 1)")
                                    }
                                }
                            }
                        }
                        Text(scene.displayTitle).font(.title2).fontWeight(.semibold)
                        Text("at \(scene.timestamp ?? "0:00")").font(.subheadline.monospacedDigit()).foregroundStyle(.secondary)
                        if let description = scene.description, !description.isEmpty { Text(description) }
                        HStack {
                            Button("Open at \(scene.timestamp ?? "0:00") ↗") { if let url = URL(string: scene.link) { openURL(url) } }.buttonStyle(.borderedProminent)
                            if let url = URL(string: scene.link) { ShareLink(item: url) }
                        }
                        if let source = scene.source {
                            NavigationLink {
                                SourceDetailView(id: source.id)
                            } label: {
                                VStack(alignment: .leading) {
                                    Text("From \(source.displayTitle)")
                                    Text(source.author.hasPrefix("@") ? source.author : "@\(source.author)").font(.subheadline).foregroundStyle(.secondary)
                                }
                            }
                        }
                        if let tags = scene.tags {
                            ForEach(["technique", "style", "format", "motion", "medium", "palette", "concepts"], id: \.self) { facet in
                                if let values = tags[facet], !values.isEmpty {
                                    Text(facet.capitalized).font(.headline)
                                    LazyVGrid(columns: [GridItem(.adaptive(minimum: 120))], alignment: .leading) {
                                        ForEach(values, id: \.self) { tag in
                                            Button(tag) {
                                                navigation.focus("idea:\(facet):\(tag)")
                                                dismiss()
                                            }.buttonStyle(.bordered).tint(facetColor(facet))
                                        }
                                    }
                                }
                            }
                        }
                    } else if store.loading { ProgressView().frame(maxWidth: .infinity).padding(80) }
                }.padding().frame(maxWidth: 850).frame(maxWidth: .infinity)
            }.navigationTitle("Scene")
            .toolbar { ToolbarItem(placement: .confirmationAction) { Button("Done") { dismiss() } } }
            .task(id: id) { await load() }
            .onChange(of: navigation.mapFocus) { dismiss() }
        }
        #if os(macOS)
        .frame(minWidth: 650, idealWidth: 800, minHeight: 650)
        #endif
    }
    private func load() async { await store.load { try await api.request("scenes/\(id)") } }
}

struct SourceDetailView: View {
    var id: String
    @Environment(APIClient.self) private var api
    @State private var store = LoadStore<Source>()
    @State private var detail: ItemID?
    @State private var sending = false
    @State private var actionError: String?
    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 16) {
                if let error = store.error { ErrorNotice(message: error) { Task { await load() } } }
                if let error = actionError { Text(error).foregroundStyle(.red) }
                if let source = store.value {
                    Text(source.displayTitle).font(.title2)
                    Text(source.author.hasPrefix("@") ? source.author : "@\(source.author)").foregroundStyle(.secondary)
                    HStack {
                        if let url = URL(string: source.url) { Link("Open source ↗", destination: url) }
                        Spacer()
                        Button { Task { await vote(source.verdict == "dislike" ? "clear" : "dislike") } } label: {
                            Label("Dislike", systemImage: source.verdict == "dislike" ? "xmark.circle.fill" : "xmark.circle")
                        }.tint(source.verdict == "dislike" ? .red : .secondary)
                        Button { Task { await vote(source.verdict == "like" ? "clear" : "like") } } label: {
                            Label("Like", systemImage: source.verdict == "like" ? "heart.fill" : "heart")
                        }.tint(source.verdict == "like" ? .pink : .secondary)
                    }.buttonStyle(.bordered).disabled(sending)
                    HStack {
                        if let platform = source.platform { Text(platform.capitalized) }
                        if let duration = source.duration { Text("\(Int(duration) / 60):\(String(format: "%02d", Int(duration) % 60))") }
                        if let origin = source.origin { Text(origin.capitalized) }
                    }.font(.subheadline).foregroundStyle(.secondary)
                    if let pitch = source.pitch, !pitch.isEmpty { Text(pitch) }
                    if let status = source.status { Text(status.capitalized).font(.caption).foregroundStyle(.secondary) }
                    let scenes = source.scenes ?? []
                    if scenes.isEmpty { ContentUnavailableView("No scenes yet", systemImage: "photo.stack") }
                    LazyVGrid(columns: [GridItem(.adaptive(minimum: 155, maximum: 280), alignment: .top)], spacing: 20) {
                        ForEach(scenes) { scene in
                            Button { detail = ItemID(id: scene.id) } label: { SceneCard(scene: scene) }.buttonStyle(.plain)
                        }
                    }
                } else if store.loading { ProgressView().frame(maxWidth: .infinity).padding(80) }
            }.padding()
        }.navigationTitle("Source")
        .task(id: id) { await load() }
        .sheet(item: $detail) { SceneDetailView(id: $0.id) }
    }
    private func load() async { await store.load { try await api.request("sources/\(id)") } }
    private func vote(_ verdict: String) async {
        sending = true; actionError = nil
        do { try await api.swipe(id, verdict); await load() } catch { actionError = error.localizedDescription }
        sending = false
    }
}
import SwiftUI

struct LibraryView: View {
    @Environment(APIClient.self) private var api
    @State private var store = LoadStore<Items<Scene>>()
    @State private var tags: [TagCount] = []
    @State private var query = ""
    @State private var selectedTag: String?
    @State private var liked = true
    @State private var detail: ItemID?
    private var requestKey: String { "\(query)|\(selectedTag ?? "")|\(liked)|\(api.revision)" }
    var body: some View {
        ScrollView {
            VStack(alignment: .leading) {
                ScrollView(.horizontal) {
                    HStack {
                        ForEach(tags.prefix(30)) { tag in
                            Button(tag.tag) { selectedTag = selectedTag == tag.id ? nil : tag.id }
                                .buttonStyle(.bordered).tint(selectedTag == tag.id ? .accentColor : .secondary)
                                .accessibilityLabel("\(tag.facet): \(tag.tag)")
                        }
                    }.padding(.horizontal)
                }
                if let tag = selectedTag { Button("Clear \(tag)", systemImage: "xmark.circle") { selectedTag = nil }.padding(.horizontal) }
                if let error = store.error { ErrorNotice(message: error) { Task { await load() } } }
                if store.loading { ProgressView().frame(maxWidth: .infinity).padding() }
                if let scenes = store.value?.items {
                    if scenes.isEmpty && !store.loading {
                        ContentUnavailableView.search(text: query)
                    } else {
                        LazyVGrid(columns: [GridItem(.adaptive(minimum: 155, maximum: 280), alignment: .top)], alignment: .leading, spacing: 20) {
                            ForEach(scenes) { scene in
                                Button { detail = ItemID(id: scene.id) } label: { SceneCard(scene: scene) }.buttonStyle(.plain)
                            }
                        }.padding()
                    }
                }
            }
        }.navigationTitle("Library")
        .searchable(text: $query, prompt: "Search scenes")
        .toolbar { Toggle("Liked only", isOn: $liked) }
        .refreshable { await load(); await loadTags() }
        .task(id: requestKey) {
            do { try await Task.sleep(for: .milliseconds(250)); try Task.checkCancellation(); await load() } catch { }
        }
        .task(id: api.server) { await loadTags() }
        .sheet(item: $detail) { SceneDetailView(id: $0.id) }
    }
    private func load() async {
        await store.load {
            var params = [URLQueryItem(name: "q", value: query), URLQueryItem(name: "limit", value: "60")]
            if liked { params.append(URLQueryItem(name: "liked", value: "1")) }
            if let selectedTag { params.append(URLQueryItem(name: "tag", value: selectedTag)) }
            return try await api.request("scenes", query: params)
        }
    }
    private func loadTags() async {
        do { let stats: Stats = try await api.request("stats"); tags = stats.tags } catch { store.error = error.localizedDescription }
    }
}
